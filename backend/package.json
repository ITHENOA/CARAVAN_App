    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260908.1": true
  }
}
